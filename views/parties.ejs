<%- include('partials/header') %>

<div class="top">
  <div>
    <div class="title">Party List</div>
  </div>
</div>

<div class="party-list-panel">
  <form method="GET" action="/parties" class="party-filter">
    <div class="party-search">
      <span>⌕</span>
      <input type="text" name="search" value="<%= search || '' %>" placeholder="Search by Party Name">
    </div>
    <button type="submit" class="btn">Search</button>
    <% if (search) { %>
      <a href="/parties" class="btn secondary">Clear</a>
    <% } %>
  </form>

  <div class="party-table-wrap">
    <table class="table party-table">
      <thead>
        <tr>
          <th>Party Name</th>
          <th>GST Number</th>
          <th>Email ID</th>
          <th>Whatsapp Number</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (parties.length) { %>
          <% parties.forEach(p => { %>
            <tr>
              <td><strong><%= p.name || '' %></strong></td>
              <td><%= p.gstin || '' %></td>
              <td><%= p.email || '' %></td>
              <td><%= p.mobile || '' %></td>
              <td class="party-actions">
                <button type="button" class="btn party-edit-btn"
                  onclick="openEditModal('<%= p._id %>', '<%= String(p.name || '').replace(/'/g, '&#39;') %>', '<%= String(p.gstin || '').replace(/'/g, '&#39;') %>', '<%= String(p.email || '').replace(/'/g, '&#39;') %>', '<%= String(p.mobile || '').replace(/'/g, '&#39;') %>')">
                  Edit
                </button>
                <button type="button" class="btn danger" onclick="openDeleteModal('<%= p._id %>', '<%= String(p.name || '').replace(/'/g, '&#39;') %>')">
                  Delete
                </button>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="5" class="empty-party">No parties found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<div id="editPartyModal" class="party-modal">
  <div class="party-modal-card">
    <button type="button" class="modal-close" onclick="closeEditModal()">×</button>
    <div class="modal-kicker">PARTY DETAILS</div>
    <h3>Edit Party</h3>
    <form id="editPartyForm" method="POST" class="form">
      <label>Party Name
        <input type="text" id="editName" name="name" required>
      </label>
      <label>GST Number
        <input type="text" id="editGstin" name="gstin">
      </label>
      <label>Email ID
        <input type="email" id="editEmail" name="email">
      </label>
      <label>Whatsapp Number
        <input type="text" id="editMobile" name="mobile">
      </label>
      <div class="modal-actions">
        <button type="button" class="btn secondary" onclick="closeEditModal()">Cancel</button>
        <button type="submit" class="btn">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<div id="deletePartyModal" class="party-modal">
  <div class="party-modal-card delete-card">
    <button type="button" class="modal-close" onclick="closeDeleteModal()">×</button>
    <div class="modal-kicker">DELETE PARTY</div>
    <h3>Delete Party?</h3>
    <p>This will remove <strong id="deletePartyName"></strong> from the party list.</p>
    <form id="deletePartyForm" method="POST" class="form">
      <label>Admin PIN
        <input type="password" name="pin" inputmode="numeric" maxlength="20" placeholder="Enter PIN" required>
      </label>
      <div class="modal-actions">
        <button type="button" class="btn secondary" onclick="closeDeleteModal()">Cancel</button>
        <button type="submit" class="btn danger">Delete Party</button>
      </div>
    </form>
  </div>
</div>

<style>
.party-list-panel{background:rgba(255,255,255,.96);border:1px solid #E2E8F0;border-radius:20px;padding:18px;box-shadow:10px 12px 22px rgba(15,23,42,.08),-5px -5px 12px rgba(255,255,255,.9),inset 1px 1px 2px rgba(255,255,255,.95)}
.party-filter{display:flex;align-items:center;gap:8px;margin-bottom:16px}
.party-search{height:40px;display:flex;align-items:center;gap:8px;flex:1;max-width:430px;border:1px solid #DCE3EC;border-radius:11px;padding:0 12px;background:linear-gradient(145deg,#fff,#F1F5F9);box-shadow:inset 2px 2px 4px rgba(15,23,42,.04),3px 3px 6px rgba(255,255,255,.9)}
.party-search span{font-size:18px;color:#64748B;line-height:1}
.party-search input{border:0;outline:0;background:transparent;width:100%;font-size:10px;color:#334155}
.party-search input::placeholder{color:#94A3B8}
.party-table-wrap{overflow-x:auto}
.party-table{margin:0;width:100%;border-collapse:separate;border-spacing:0}
.party-table th{background:#F8FAFC;color:#64748B;font-size:9px;font-weight:900;letter-spacing:.4px;padding:13px 12px;border-bottom:1px solid #E2E8F0;text-align:left}
.party-table td{padding:13px 12px;border-bottom:1px solid #EEF2F6;color:#475569;font-size:10px;vertical-align:middle}
.party-table tbody tr:hover{background:#F8FBFF}
.party-table td strong{color:#0F172A;font-size:10px}
.party-actions{white-space:nowrap;display:flex;gap:6px}
.party-actions .btn{padding:7px 10px}
.btn.danger{background:linear-gradient(145deg,#EF4444,#B91C1C);color:#fff;border-color:#DC2626;box-shadow:5px 6px 10px rgba(185,28,28,.15),inset 1px 1px 2px rgba(255,255,255,.25)}
.btn.danger:hover{transform:translateY(-2px)}
.empty-party{text-align:center!important;padding:35px!important;color:#94A3B8!important}
.party-modal{display:none;position:fixed;inset:0;background:rgba(15,23,42,.52);z-index:1000;justify-content:center;align-items:center;padding:20px}
.party-modal-card{position:relative;background:linear-gradient(145deg,#fff,#F7FAFC);padding:24px;border:1px solid #E2E8F0;border-radius:20px;width:430px;max-width:100%;box-shadow:20px 25px 45px rgba(15,23,42,.25)}
.party-modal-card h3{margin:5px 0 17px;color:#0F172A;font-size:18px}
.party-modal-card p{font-size:10px;color:#64748B;line-height:1.6;margin:0 0 14px}
.party-modal-card .form{display:flex;flex-direction:column;gap:12px}
.party-modal-card label{font-size:9px;font-weight:800;color:#475569}
.party-modal-card input{display:block;width:100%;margin-top:6px;border:1px solid #DCE3EC;border-radius:10px;padding:10px 11px;background:#fff;color:#0F172A;outline:none;font-size:10px}
.party-modal-card input:focus{border-color:#38BDF8;box-shadow:0 0 0 3px rgba(56,189,248,.1)}
.modal-kicker{font-size:7px;letter-spacing:1.5px;font-weight:900;color:#2563EB}
.modal-close{position:absolute;right:13px;top:10px;width:28px;height:28px;border:0;border-radius:9px;background:#EEF2F7;color:#64748B;font-size:18px;cursor:pointer}
.modal-actions{display:flex;justify-content:flex-end;gap:7px;margin-top:5px}
.delete-card{max-width:390px}
@media(max-width:600px){.party-filter{flex-wrap:wrap}.party-search{max-width:none;flex-basis:100%}.party-actions{display:flex}}
</style>

<script>
function openEditModal(id,name,gstin,email,mobile){
  document.getElementById('editName').value=name;
  document.getElementById('editGstin').value=gstin;
  document.getElementById('editEmail').value=email;
  document.getElementById('editMobile').value=mobile;
  document.getElementById('editPartyForm').action='/parties/update/'+id;
  document.getElementById('editPartyModal').style.display='flex';
}
function closeEditModal(){document.getElementById('editPartyModal').style.display='none'}
function openDeleteModal(id,name){
  document.getElementById('deletePartyName').innerText=name;
  document.getElementById('deletePartyForm').action='/parties/delete/'+id;
  document.getElementById('deletePartyModal').style.display='flex';
}
function closeDeleteModal(){document.getElementById('deletePartyModal').style.display='none'}
</script>

<%- include('partials/footer') %>