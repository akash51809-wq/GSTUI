<%- include('partials/header') %>
<div class="top"><div><div class="title">Customer & Supplier Directory</div><div class="sub">Invoice upload के साथ parties automatic create होती हैं।</div></div></div>
<div class="panel"><table class="table"><thead><tr><th>Party</th><th>GSTIN</th><th>Email</th><th>Mobile</th><th>Action</th></tr></thead><tbody><% parties.forEach(p => { %><tr><td><%= p.name %></td><td><%= p.gstin || '' %></td><td><%= p.email || '' %></td><td><%= p.mobile || '' %></td><td><button type="button" class="btn" onclick="openEditModal('<%= p._id %>','<%= p.name %>','<%= p.email || '' %>','<%= p.mobile || '' %>')">Edit</button></td></tr><% }) %></tbody></table></div>
<div id="editPartyModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;justify-content:center;align-items:center"><div style="background:#fff;padding:25px;border-radius:12px;width:420px;max-width:90%"><h3>Edit Party Details: <span id="modalPartyName"></span></h3><form id="editPartyForm" method="POST" class="form"><label>Email Address<input type="email" id="editEmail" name="email"></label><label>Mobile Number<input type="text" id="editMobile" name="mobile"></label><div><button type="button" class="btn secondary" onclick="closeEditModal()">Cancel</button> <button type="submit" class="btn">Save Changes</button></div></form></div></div>
<script>function openEditModal(id,name,email,mobile){document.getElementById('modalPartyName').innerText=name;document.getElementById('editEmail').value=email;document.getElementById('editMobile').value=mobile;document.getElementById('editPartyForm').action='/parties/update/'+id;document.getElementById('editPartyModal').style.display='flex'}function closeEditModal(){document.getElementById('editPartyModal').style.display='none'}</script>
<%- include('partials/footer') %>