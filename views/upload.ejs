<%- include('partials/header') %>
<div class="top"><div class="title">Upload Invoices</div></div>
<div class="panel"><form id="uploadForm"><div class="form"><label>Select PDF Invoices (Max 50)<input type="file" name="invoices" multiple accept="application/pdf" required></label></div><div><button type="submit" class="btn" id="uploadBtn">Upload & Process</button></div></form><div id="status" style="margin-top:15px"></div><div id="resultsTable" style="margin-top:15px;display:none"></div></div>
<div id="emailModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;justify-content:center;align-items:center"><div style="background:#fff;padding:25px;border-radius:12px;width:420px;max-width:90%"><h3>⚠️ Party Email Missing</h3><p>यह SELL invoice पिछले महीने का है। ईमेल भेजने के लिए पार्टी का ईमेल ज़रूरी है।</p><p>Party: <strong id="modalPartyName"></strong></p><p>Invoice No: <strong id="modalInvNum"></strong></p><p id="modalQueueInfo" class="small"></p><input type="hidden" id="modalPartyId"><input type="hidden" id="modalInvoiceId"><div class="form"><label>ईमेल दर्ज करें:<input type="email" id="modalEmailInput" placeholder="party@example.com"></label></div><div><button type="button" class="btn secondary" id="skipBtn" onclick="skipEmailModal()">Skip / Ignore</button> <button type="button" class="btn" id="sendBtn" onclick="saveAndSendModalEmail()">Save & Send Mail</button></div></div></div>
<script>
let pendingQueue=[],totalPendingCount=0,currentIndex=0,partyEmailCache={};
document.getElementById('uploadForm').addEventListener('submit',async e=>{e.preventDefault();const formData=new FormData(e.target),statusDiv=document.getElementById('status'),uploadBtn=document.getElementById('uploadBtn');uploadBtn.disabled=true;uploadBtn.innerText='Processing...';statusDiv.innerHTML='⏳ Uploading and processing invoices... Please wait.';try{const res=await fetch('/api/invoices/upload',{method:'POST',body:formData});const data=await res.json();if(res.ok){renderResults(data.results);if(data.pendingEmails?.length){pendingQueue=data.pendingEmails;totalPendingCount=pendingQueue.length;currentIndex=0;showNextEmailModal()}else statusDiv.innerHTML='✅ Upload पूरा हो गया!'}else statusDiv.innerHTML='❌ Error: '+(data.error||'Upload failed')}catch(err){statusDiv.innerHTML='❌ Network Error: '+err.message}finally{uploadBtn.disabled=false;uploadBtn.innerText='Upload & Process'}});
function renderResults(results){const c=document.getElementById('resultsTable');let h='<table class="table"><tr><th>#</th><th>File</th><th>Invoice No</th><th>Type</th><th>Status</th><th>Email</th></tr>';for(const r of results){let s=r.status==='completed'?'✅ Done':r.status==='duplicate'?'⚠️ Duplicate':'❌ '+(r.error||'Failed');let e=r.autoEmailSent?'📧 Sent':r.emailMissing?'📧 Pending (no email)':r.autoEmailError?'📧 Error':'—';h+=`<tr><td>${r.index}</td><td>${r.file||''}</td><td>${r.invoiceNumber||'-'}</td><td>${r.invoiceType||'-'}</td><td>${s}</td><td>${e}</td></tr>`}c.innerHTML=h+'</table>';c.style.display='block'}
function showNextEmailModal(){if(!pendingQueue.length){document.getElementById('emailModal').style.display='none';document.getElementById('status').innerHTML='✅ Upload और ईमेल processing पूरी हो गई!';return}currentIndex++;const x=pendingQueue[0];document.getElementById('modalPartyName').innerText=x.partyName;document.getElementById('modalInvNum').innerText=x.invoiceNumber;document.getElementById('modalPartyId').value=x.partyId;document.getElementById('modalInvoiceId').value=x.invoiceId;document.getElementById('modalEmailInput').value=partyEmailCache[x.partyId]||'';document.getElementById('modalQueueInfo').innerText='Invoice '+currentIndex+' of '+totalPendingCount;document.getElementById('emailModal').style.display='flex'}
function skipEmailModal(){pendingQueue.shift();showNextEmailModal()}
async function saveAndSendModalEmail(){const partyId=document.getElementById('modalPartyId').value,invoiceId=document.getElementById('modalInvoiceId').value,email=document.getElementById('modalEmailInput').value.trim();if(!email)return alert('कृपया valid ईमेल डालें!');try{const res=await fetch('/api/parties/save-email-and-send',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({partyId,email,invoiceId})});const data=await res.json();if(res.ok){partyEmailCache[partyId]=email;alert('✅ '+data.message)}else alert('❌ '+(data.error||'Failed'))}catch(err){alert('❌ '+err.message)}pendingQueue.shift();showNextEmailModal()}
</script><%- include('partials/footer') %>